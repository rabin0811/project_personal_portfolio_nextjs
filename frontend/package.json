{
  "name": "rabin-humagain-portfolio",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "postinstall": "node scripts/patch-nft-win.mjs",
    "dev": "next dev",
    "build": "next build",
    "start": "next start",
    "lint": "eslint",
    "typecheck": "tsc --noEmit",
    "db:generate": "prisma generate && node scripts/inline-prisma-wasm.mjs",
    "db:apply": "node scripts/db-apply.mjs --remote",
    "db:apply:local": "node scripts/db-apply.mjs --local",
    "db:seed": "node scripts/seed.mjs",
    "db:seed:remote": "node scripts/seed.mjs --remote",
    "build:cf": "opennextjs-cloudflare build --dangerouslyUseUnsupportedNextVersion && node scripts/patch-worker-wasm.mjs",
    "preview": "wrangler dev",
    "deploy": "npm run build:cf && opennextjs-cloudflare deploy"
  },
  "dependencies": {
    "@prisma/adapter-d1": "^6.9.0",
    "@prisma/client": "^6.9.0",
    "bcryptjs": "^3.0.2",
    "jose": "^6.0.10",
    "next": "^15.5.23",
    "react": "19.2.8",
    "react-dom": "19.2.8"
  },
  "devDependencies": {
    "@opennextjs/cloudflare": "^1.20.2",
    "@tailwindcss/postcss": "^4",
    "@types/node": "^20",
    "@types/react": "^19",
    "@types/react-dom": "^19",
    "dotenv": "^17.0.0",
    "eslint": "^9.22.0",
    "eslint-config-next": "^15.5.21",
    "prisma": "^6.9.0",
    "tailwindcss": "^4",
    "typescript": "^5",
    "wrangler": "^4.58.0"
  }
}
