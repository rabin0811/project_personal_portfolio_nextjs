generator client {
  provider   = "prisma-client-js"
  engineType = "client"
  output     = "../generated/prisma"
}

datasource db {
  provider = "sqlite"
  url      = "file:./d1-placeholder.db"
}

model User {
  id           String   @id @default(cuid())
  email        String   @unique
  passwordHash String
  role         String   @default("admin")
  createdAt    DateTime @default(now())
}

model SiteConfig {
  id           Int     @id @default(1)
  bio          String  @default("")
  profilePhoto String?
  email        String?
  github       String?
  linkedin     String?
  twitter      String?
  location     String?
}

model Project {
  id          String         @id @default(cuid())
  title       String
  slug        String         @unique
  summary     String
  description String
  liveUrl     String?
  repoUrl     String?
  techTags    String         @default("")
  featured    Boolean        @default(false)
  published   Boolean        @default(true)
  order       Int            @default(0)
  createdAt   DateTime       @default(now())
  screenshots ProjectImage[]
}

model ProjectImage {
  id        String  @id @default(cuid())
  projectId String
  url       String
  order     Int     @default(0)
  project   Project @relation(fields: [projectId], references: [id], onDelete: Cascade)
}

model Skill {
  id       String @id @default(cuid())
  name     String
  category String
  order    Int    @default(0)
}

model Experience {
  id          String  @id @default(cuid())
  role        String
  company     String
  dates       String
  description String?
  order       Int     @default(0)
}

model GalleryImage {
  id         String   @id @default(cuid())
  url        String
  caption    String?
  location   String?
  uploadedAt DateTime @default(now())
}

model BlogPost {
  id          String      @id @default(cuid())
  title       String
  slug        String      @unique
  location    String?
  publishedAt DateTime?
  status      String      @default("draft")
  blocks      BlogBlock[]
}

model BlogBlock {
  id      String   @id @default(cuid())
  postId  String
  type    String
  content String   @default("")
  caption String?
  order   Int      @default(0)
  post    BlogPost @relation(fields: [postId], references: [id], onDelete: Cascade)
}

model ContactMessage {
  id        String   @id @default(cuid())
  name      String
  email     String
  message   String
  read      Boolean  @default(false)
  createdAt DateTime @default(now())
}
